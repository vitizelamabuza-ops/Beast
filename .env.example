# Example environment variables for the MT5 bot

# Login credentials (optional: if left empty assumes terminal is logged in)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=  # optional path to terminal64.exe

# Trading settings
SYMBOL=EURUSD
TIMEFRAME=H1
LOT_SIZE=0.01
RISK_PERCENT=1.0
CONFIDENCE_THRESHOLD=85
MIN_CONFIDENCE_TO_TRADE=40
POLL_INTERVAL=60
MAX_SPREAD_PIPS=3.0
HIST_PERIODS=500
MAX_TRADES_PER_DAY=3

# FEATURE TOGGLES (for testing/debugging)
DEBUG_MODE=true          # Set to 'true' to see indicator values every tick
ENABLE_FORCE_TEST=false  # Set to 'true' to trigger test BUY signal on startup
ENABLE_VISUAL_ARROWS=true  # Draw arrows on chart
ENABLE_DASHBOARD=true    # Show live dashboard
